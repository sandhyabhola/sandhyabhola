<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="320" viewBox="0 0 1000 320" role="img" aria-label="Animated banner" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b1020"/>
      <stop offset="1" stop-color="#16213e"/>
    </linearGradient>
    <linearGradient id="txt" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#58a6ff"/>
      <stop offset="1" stop-color="#bc8cff"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="5" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <rect width="1000" height="320" rx="16" fill="url(#bg)"/>

  <!-- twinkling stars -->
  <g fill="#ffffff">
    <circle cx="120" cy="100" r="1.6"><animate attributeName="opacity" values="0.2;1;0.2" dur="3s" repeatCount="indefinite"/></circle>
    <circle cx="260" cy="290" r="1.4"><animate attributeName="opacity" values="1;0.2;1" dur="4s" repeatCount="indefinite"/></circle>
    <circle cx="470" cy="60" r="1.8"><animate attributeName="opacity" values="0.3;1;0.3" dur="2.5s" repeatCount="indefinite"/></circle>
    <circle cx="720" cy="300" r="1.5"><animate attributeName="opacity" values="1;0.2;1" dur="3.5s" repeatCount="indefinite"/></circle>
    <circle cx="900" cy="95" r="1.7"><animate attributeName="opacity" values="0.2;1;0.2" dur="2.8s" repeatCount="indefinite"/></circle>
    <circle cx="35" cy="190" r="1.3"><animate attributeName="opacity" values="1;0.3;1" dur="3.2s" repeatCount="indefinite"/></circle>
    <circle cx="965" cy="215" r="1.5"><animate attributeName="opacity" values="0.3;1;0.3" dur="4.2s" repeatCount="indefinite"/></circle>
  </g>

  <!-- floating skill chips -->
  <g transform="translate(40,50)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 -12;0 0" dur="4s" repeatCount="indefinite"/>
    <rect width="90" height="34" rx="17" fill="#0d1117" stroke="#58a6ff" filter="url(#glow)"/><text x="45" y="22" text-anchor="middle" fill="#58a6ff" font-size="15" font-family="Consolas, monospace">Python</text></g></g>

  <g transform="translate(110,140)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 10;0 0" dur="5s" repeatCount="indefinite"/>
    <rect width="64" height="34" rx="17" fill="#0d1117" stroke="#bc8cff" filter="url(#glow)"/><text x="32" y="22" text-anchor="middle" fill="#bc8cff" font-size="15" font-family="Consolas, monospace">SQL</text></g></g>

  <g transform="translate(40,230)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 -10;0 0" dur="4.5s" repeatCount="indefinite"/>
    <rect width="90" height="34" rx="17" fill="#0d1117" stroke="#3fb950" filter="url(#glow)"/><text x="45" y="22" text-anchor="middle" fill="#3fb950" font-size="15" font-family="Consolas, monospace">OpenCV</text></g></g>

  <g transform="translate(820,45)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 11;0 0" dur="4.2s" repeatCount="indefinite"/>
    <rect width="64" height="34" rx="17" fill="#0d1117" stroke="#f778ba" filter="url(#glow)"/><text x="32" y="22" text-anchor="middle" fill="#f778ba" font-size="15" font-family="Consolas, monospace">RAG</text></g></g>

  <g transform="translate(860,140)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 -12;0 0" dur="5.2s" repeatCount="indefinite"/>
    <rect width="90" height="34" rx="17" fill="#0d1117" stroke="#58a6ff" filter="url(#glow)"/><text x="45" y="22" text-anchor="middle" fill="#58a6ff" font-size="15" font-family="Consolas, monospace">Docker</text></g></g>

  <g transform="translate(810,230)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 10;0 0" dur="3.8s" repeatCount="indefinite"/>
    <rect width="80" height="34" rx="17" fill="#0d1117" stroke="#d29922" filter="url(#glow)"/><text x="40" y="22" text-anchor="middle" fill="#d29922" font-size="15" font-family="Consolas, monospace">Azure</text></g></g>

  <g transform="translate(290,22)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 9;0 0" dur="4.6s" repeatCount="indefinite"/>
    <rect width="92" height="34" rx="17" fill="#0d1117" stroke="#3fb950" filter="url(#glow)"/><text x="46" y="22" text-anchor="middle" fill="#3fb950" font-size="15" font-family="Consolas, monospace">FastAPI</text></g></g>

  <g transform="translate(600,22)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 -9;0 0" dur="5s" repeatCount="indefinite"/>
    <rect width="116" height="34" rx="17" fill="#0d1117" stroke="#bc8cff" filter="url(#glow)"/><text x="58" y="22" text-anchor="middle" fill="#bc8cff" font-size="15" font-family="Consolas, monospace">Agentic AI</text></g></g>

  <g transform="translate(330,272)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 -8;0 0" dur="4.1s" repeatCount="indefinite"/>
    <rect width="96" height="34" rx="17" fill="#0d1117" stroke="#d29922" filter="url(#glow)"/><text x="48" y="22" text-anchor="middle" fill="#d29922" font-size="15" font-family="Consolas, monospace">Power BI</text></g></g>

  <g transform="translate(540,272)"><g><animateTransform attributeName="transform" type="translate" values="0 0;0 8;0 0" dur="4.8s" repeatCount="indefinite"/>
    <rect width="132" height="34" rx="17" fill="#0d1117" stroke="#f778ba" filter="url(#glow)"/><text x="66" y="22" text-anchor="middle" fill="#f778ba" font-size="15" font-family="Consolas, monospace">Deep Learning</text></g></g>

  <!-- title -->
  <g filter="url(#glow)">
    <text x="500" y="150" text-anchor="middle" font-size="46" font-weight="700" font-family="Segoe UI, Arial, sans-serif" fill="url(#txt)">
      Hi, I'm Sandhyarani Bhola
      <animate attributeName="opacity" values="0.85;1;0.85" dur="3s" repeatCount="indefinite"/>
    </text>
  </g>
  <text x="500" y="192" text-anchor="middle" font-size="20" font-family="Segoe UI, Arial, sans-serif" fill="#c9d1d9">Data Scientist · AI/ML Engineer</text>

  <!-- open to work pill -->
  <g transform="translate(410,214)">
    <rect width="180" height="34" rx="17" fill="#0d1117" stroke="#3fb950" filter="url(#glow)"/>
    <circle cx="24" cy="17" r="5" fill="#3fb950"><animate attributeName="opacity" values="1;0.25;1" dur="1.6s" repeatCount="indefinite"/></circle>
    <text x="100" y="22" text-anchor="middle" font-size="15" font-family="Segoe UI, Arial, sans-serif" fill="#3fb950">Open to work</text>
  </g>
</svg>
